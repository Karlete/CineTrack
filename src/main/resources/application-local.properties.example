# Copia este fichero como application-local.properties (gitignorado) y
# rellena tus valores reales. Se activa con SPRING_PROFILES_ACTIVE=local
# (variable de entorno en la run configuration de IntelliJ). Solo sobrescribe
# lo que difiere de application.properties (config base / produccion).

spring.datasource.url=jdbc:postgresql://localhost:5432/cinetrack_dev
spring.datasource.username=your local db user
spring.datasource.password=your local db password

spring.jpa.show-sql=true
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

jwt.secret=your local jwt secret

tmdb.api-key=your tmdb api key
